# Stripe (required for checkout, verify-session, webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical site URL for Checkout success/cancel redirects (server reads SITE_URL first, then NEXT_PUBLIC_SITE_URL)
SITE_URL=https://ligs.io
# NEXT_PUBLIC_SITE_URL=https://ligs.io

# Optional: return 503 from IOC API routes
# IOC_API_OFF=1
